doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Smart Wallet
  link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
  style.
    :root {
    --primary: #1f4ed8;
    --secondary: #0f172a;
    --accent: #22c55e;
    --light: #f8fafc;
    --text: #334155;
    }
    * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    }
    body {
    font-family: Arial, Helvetica, sans-serif;
    color: var(--text);
    background: linear-gradient(135deg, #eef4ff 0%, #f9fbff 100%);
    line-height: 1.6;
    }
    .page {
    min-height: 100vh;
    }
    .topbar {
    background: var(--secondary);
    color: white;
    padding: 12px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 0.95rem;
    }
    .topbar .contact-group {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    align-items: center;
    }
    .social-links {
    display: flex;
    align-items: center;
    gap: 10px;
    }
    .social-links a {
    color: white;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255,255,255,0.12);
    transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
    }
    .social-links a:hover {
    color: blue;
    background: rgba(255,255,255,0.2);
    transform: translateY(-1px);
    }
    .social-links svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
    }
    header {
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(10px);
    padding: 18px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 8px 30px rgba(15, 23, 42, 0.08);
    position: sticky;
    top: 0;
    z-index: 100;
    }
    .logo {
    display: flex;
    align-items: center;
    gap: 15px;
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--secondary);
    text-decoration: none;
    }
    .logo img {
    width: 130px;
    height: 130px;
    border-radius: 12px;
    object-fit: cover;
    display: block;
    }
    .company-name {
    font-size: 24px;
    font-weight: 700;
    color: #667eea;
    text-align: center;
    }
    nav ul {
    list-style: none;
    display: flex;
    gap: 24px;
    }
    nav a {
    text-decoration: none;
    color: var(--secondary);
    font-weight: 600;
    }
    nav a:hover {
    color: var(--primary);
    }
    .nav-admin-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 18px;
    border-radius: 999px;
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: white;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 8px 18px rgba(37, 99, 235, 0.25);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .nav-admin-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 22px rgba(37, 99, 235, 0.28);
    color: white;
    }
    .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 30px;
    padding: 60px 24px 80px;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    }
    .hero-content h1 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    color: var(--secondary);
    margin-bottom: 16px;
    }
    .hero-content p {
    font-size: 1.05rem;
    margin-bottom: 24px;
    max-width: 600px;
    }
    .btn-group {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 8px;
    }
    .btn {
    padding: 12px 22px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    min-width: 130px;
    text-align: center;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(31, 78, 216, 0.18);
    }
    .btn-primary {
    background: var(--primary);
    color: white;
    }
    .btn-secondary {
    background: rgb(248, 217, 150);
    color: var(--primary);
    border: 1px solid #dbeafe;
    }
    .hero-card {
    background: white;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.12);
    width: 100%;
    aspect-ratio: 4 / 3;
    }
    .hero-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    }
    section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 24px 70px;
    }
    .section-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    }
    .card {
    background: white;
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
    }
    .card h2 {
    margin-bottom: 10px;
    color: var(--secondary);
    }
    .card ul {
    padding-left: 18px;
    }
    /* ============= TESTIMONIALS SECTION ============= */
    .testimonials-section {
    background: white;
    padding: 80px 24px;
    }
    .testimonials-container {
    max-width: 1200px;
    margin: 0 auto;
    }
    .testimonials-title {
    text-align: center;
    font-size: 2.5rem;
    color: var(--secondary);
    margin-bottom: 50px;
    font-weight: 700;
    }
    .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    }
    .testimonial-card {
    background: linear-gradient(135deg, #f8f9fa 0%, #f0f4f8 100%);
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border-left: 5px solid var(--primary);
    }
    .testimonial-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 40px rgba(31, 78, 216, 0.15);
    }
    .stars {
    color: #fbbf24;
    font-size: 1.2rem;
    margin-bottom: 15px;
    letter-spacing: 2px;
    }
    .testimonial-text {
    font-size: 1rem;
    color: var(--text);
    margin-bottom: 20px;
    line-height: 1.8;
    font-style: italic;
    }
    .testimonial-author {
    display: flex;
    align-items: center;
    gap: 15px;
    }
    .author-avatar {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1f4ed8, #0f172a);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 700;
    font-size: 1.2rem;
    }
    .author-info h4 {
    color: var(--secondary);
    font-weight: 700;
    margin-bottom: 3px;
    }
    .author-info p {
    color: #999;
    font-size: 0.9rem;
    }
    /* ============= FOOTER ============= */
    footer {
    background: linear-gradient(135deg, #2d3561 0%, #1a1f3a 100%);
    color: white;
    padding: 40px 20px;
    text-align: center;
    }
    .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    }
    .footer-text {
    font-size: 14px;
    margin-bottom: 15px;
    opacity: 0.9;
    }
    .footer-links {
    display: flex;
    justify-content: center;
    gap: 30px;
    margin: 20px 0;
    flex-wrap: wrap;
    }
    .footer-links a {
    color: white;
    text-decoration: none;
    font-size: 14px;
    transition: opacity 0.3s ease;
    opacity: 0.8;
    }
    .footer-links a:hover {
    opacity: 1;
    }
    .footer-copyright {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 20px;
    margin-top: 20px;
    font-size: 12px;
    opacity: 0.8;
    }
    .chat-toggle {
    position: fixed;
    right: 20px;
    bottom: 20px;
    background: linear-gradient(135deg, var(--primary), #2563eb);
    color: white;
    border: none;
    border-radius: 999px;
    width: 56px;
    height: 56px;
    font-size: 24px;
    cursor: pointer;
    box-shadow: 0 10px 25px rgba(31, 78, 216, 0.3);
    z-index: 1000;
    }
    .chat-widget {
    position: fixed;
    right: 20px;
    bottom: 90px;
    width: min(320px, calc(100vw - 24px));
    background: white;
    border-radius: 16px;
    box-shadow: 0 15px 40px rgba(15, 23, 42, 0.18);
    overflow: hidden;
    display: none;
    flex-direction: column;
    z-index: 1000;
    }
    .chat-widget.open {
    display: flex;
    }
    .chat-header {
    background: linear-gradient(135deg, var(--secondary), var(--primary));
    color: white;
    padding: 14px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    }
    .chat-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #f8fafc;
    }
    .chat-message {
    padding: 10px 12px;
    border-radius: 10px;
    font-size: 0.95rem;
    line-height: 1.4;
    }
    .chat-message.bot {
    background: #e0ebff;
    color: var(--secondary);
    }
    .chat-message.user {
    background: var(--accent);
    color: white;
    align-self: flex-end;
    }
    .chat-input-row {
    display: flex;
    gap: 8px;
    padding: 12px 16px 16px;
    background: white;
    }
    .chat-input-row input {
    flex: 1;
    border: 1px solid #dbeafe;
    border-radius: 999px;
    padding: 10px 12px;
    font-size: 0.95rem;
    }
    .chat-input-row button {
    border: none;
    background: var(--primary);
    color: white;
    border-radius: 999px;
    padding: 10px 14px;
    cursor: pointer;
    }
    @media (max-width: 860px) {
    .hero,
    .section-grid {
    grid-template-columns: 1fr;
    }
    header {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    }
    nav ul {
    flex-wrap: wrap;
    gap: 14px;
    }
    .btn-group {
    flex-direction: column;
    align-items: center;
    }
    .btn {
    width: 100%;
    max-width: 220px;
    }
    .testimonials-title {
    font-size: 2rem;
    }
    .testimonials-grid {
    grid-template-columns: 1fr;
    }
    .footer-links {
    gap: 15px;
    }
    }
    @media (max-width: 480px) {
    .testimonials-title {
    font-size: 1.5rem;
    }
    .testimonial-card {
    padding: 20px;
    }
    .footer-links {
    flex-direction: column;
    gap: 10px;
    }
    }
