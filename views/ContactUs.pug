doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Contact - Smart Wallet
  link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
  style.
    * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    }
    body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
    color: #333;
    }
    /* ============= SECTION 1: MAP SECTION ============= */
    .map-section {
    padding: 60px 20px;
    background: white;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    .map-container {
    max-width: 1200px;
    margin: 0 auto;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }
    .map-container iframe {
    width: 100%;
    height: 400px;
    border: none;
    }
    /* ============= SECTION 2: INFO + FORM SECTION ============= */
    .contact-section {
    padding: 60px 20px;
    background: #f8f9fa;
    min-height: auto;
    }
    .contact-container {
    max-width: 1200px;
    margin: 0 auto;
    }
    .section-title {
    text-align: center;
    font-size: 42px;
    color: #667eea;
    margin-bottom: 50px;
    font-weight: 700;
    letter-spacing: -0.5px;
    }
    .content-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
    }
    /* Company Info Column */
    .company-info {
    display: flex;
    flex-direction: column;
    gap: 30px;
    }
    .company-card {
    background: white;
    padding: 30px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .company-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(102, 126, 234, 0.2);
    }
    .company-logo-section {
    text-align: center;
    margin-bottom: 20px;
    }
    .company-logo {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 15px;
    color: white;
    font-size: 40px;
    box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
    }
    .company-logo-img {
    width: 100px;
    height: 100px;
    object-fit: cover;
    border-radius: 15px;
    margin: 0 auto 15px;
    display: block;
    box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
    border: 3px solid white;
    }
    .company-name {
    font-size: 24px;
    font-weight: 700;
    color: #667eea;
    text-align: center;
    }
    .info-item {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    }
    .info-icon {
    width: 45px;
    height: 45px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    flex-shrink: 0;
    font-size: 18px;
    }
    .info-content h4 {
    font-size: 14px;
    color: #999;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 5px;
    font-weight: 600;
    }
    .info-content p {
    font-size: 16px;
    color: #333;
    line-height: 1.5;
    }
    /* Form Column */
    .form-section {
    background: white;
    padding: 40px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    }
    .form-title {
    font-size: 24px;
    color: #333;
    margin-bottom: 30px;
    font-weight: 700;
    }
    .form-group {
    margin-bottom: 20px;
    }
    .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
    }
    label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: #667eea;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    }
    input[type="text"],
    input[type="email"],
    input[type="phone"],
    textarea {
    width: 100%;
    padding: 12px 15px;
    border: 2px solid #e0e0e0;
    border-radius: 8px;
    font-size: 14px;
    font-family: inherit;
    transition: all 0.3s ease;
    background: #f8f9fa;
    }
    input[type="text"]:focus,
    input[type="email"]:focus,
    input[type="phone"]:focus,
    textarea:focus {
    outline: none;
    background: white;
    border-color: #667eea;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }
    textarea {
    resize: vertical;
    min-height: 150px;
    line-height: 1.5;
    }
    .message-label {
    font-size: 14px;
    font-weight: 600;
    color: #667eea;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: block;
    margin: 30px 0 15px 0;
    }
    .btn-submit {
    width: 100%;
    padding: 15px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 10px;
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
    }
    .btn-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
    background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
    }
    .btn-submit:active {
    transform: translateY(0);
    }
    /* ============= SECTION 3: FOOTER ============= */
    footer {
    background: linear-gradient(135deg, #2d3561 0%, #1a1f3a 100%);
    color: white;
    padding: 40px 20px;
    text-align: center;
    }
    .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    }
    .footer-text {
    font-size: 14px;
    margin-bottom: 15px;
    opacity: 0.9;
    }
    .footer-links {
    display: flex;
    justify-content: center;
    gap: 30px;
    margin: 20px 0;
    flex-wrap: wrap;
    }
    .footer-links a {
    color: white;
    text-decoration: none;
    font-size: 14px;
    transition: opacity 0.3s ease;
    opacity: 0.8;
    }
    .footer-links a:hover {
    opacity: 1;
    }
    .footer-copyright {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 20px;
    margin-top: 20px;
    font-size: 12px;
    opacity: 0.8;
    }
    /* Responsive Design */
    @media (max-width: 768px) {
    .content-grid {
    grid-template-columns: 1fr;
    gap: 30px;
    }
    .form-row {
    grid-template-columns: 1fr;
    }
    .section-title {
    font-size: 28px;
    margin-bottom: 30px;
    }
    .map-container iframe {
    height: 300px;
    }
    .form-section {
    padding: 25px;
    }
    .company-info {
    gap: 20px;
    }
    .company-card {
    padding: 20px;
    }
    .footer-links {
    gap: 15px;
    }
    }
    @media (max-width: 480px) {
    .section-title {
    font-size: 22px;
    }
    .form-section {
    padding: 15px;
    }
    .company-card {
    padding: 15px;
    }
    .map-container iframe {
    height: 250px;
    }
    }
// SECTION 1: MAP SECTION
section.map-section
  .map-container
    iframe(src='https://www.google.com/maps?q=Kampala,+Uganda&output=embed' allowfullscreen='' loading='lazy' referrerpolicy='no-referrer-when-downgrade')
// SECTION 2: INFO + FORM SECTION
section.contact-section
  .contact-container
    h1.section-title Get In Touch
    .content-grid
      // Company Info Column
      .company-info
        .company-card
          .company-logo-section
            img.company-logo-img(src='/images/Wallet1-2292428_1920.jpg' alt='Smart Wallet Logo')
            h2.company-name Smart Wallet
        .company-card
          .info-item
            .info-icon
              i.fas.fa-map-marker-alt
            .info-content
              h4 Physical Address
              p
                | Entebbe Road,
                br
                | Kampala, Uganda
        .company-card
          .info-item
            .info-icon
              i.fas.fa-envelope
            .info-content
              h4 Email Address
              p
                a(href='mailto:contact@smartwallet.com' style='color: #667eea; text-decoration: none;') contact@smartwallet.com
                br
                a(href='mailto:support@smartwallet.com' style='color: #667eea; text-decoration: none;') support@smartwallet.com
      // Form Column
      .form-section
        h3.form-title Send us a Message
        form#contactForm(novalidate='')
          .form-row
            .form-group
              label(for='firstname') First Name
              input#firstname(type='text' name='firstname' placeholder='Enter your first name' required='')
            .form-group
              label(for='lastname') Last Name
              input#lastname(type='text' name='lastname' placeholder='Enter your last name' required='')
          .form-row
            .form-group
              label(for='email') Email Address
              input#email(type='email' name='email' placeholder='your.email@example.com' required='')
            .form-group
              label(for='phone') Telephone
              input#phone(type='phone' name='phone' placeholder='+1 (555) 000-0000' required='')
          label.message-label Your Message
          textarea#message(name='message' placeholder='Tell us your thoughts, questions, or feedback...' required='')
          button.btn-submit(type='submit') Send Message
// SECTION 3: FOOTER
footer
  .footer-content
    p.footer-text We&apos;re here to help. Reach out to us anytime!
    .footer-links
      a(href='/') Home
      a(href='/about') About Us
      a(href='#services') Services
      a(href='/policy') Privacy Policy
      a(href='/terms') Terms &amp; Conditions
    .footer-copyright
      p
        | &copy; 2026 Smart Wallet. All Rights Reserved | Designed with 
        i.fas.fa-heart(style='color: #ff6b6b;')
        |  for Modern Finance
