    .actions
      button(type='submit') Save Budget
script.
  const budgetForm = document.getElementById('budgetForm');
  const categories = ['foodLimit', 'transportLimit', 'rentLimit', 'utilityLimit', 'healthcareLimit', 'entertainmentLimit', 'shoppingLimit', 'otherLimit'];

  budgetForm.addEventListener('submit', function (event) {
    let hasEmptyOrZero = false;

    for (const fieldName of categories) {
      const input = document.getElementById(fieldName.replace('Limit', 'Limit')) || document.getElementsByName(fieldName)[0];
      const value = Number((input && input.value) || 0);

      if (!input || input.value.trim() === '' || value <= 0) {
        hasEmptyOrZero = true;
        break;
      }
    }

    if (hasEmptyOrZero) {
      event.preventDefault();
      alert('All category limits must be filled and cannot be zero.');
    }
  });
