doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Smart Wallet Menu
  style.
    :root {
    --primary: #1f4ed8;
    --primary-dark: #1539a7;
    --primary-soft: #eaf1ff;
    --bg: #eef4ff;
    --card: #ffffff;
    --text: #0f172a;
    --muted: #475569;
    --line: #dfeafc;
    --success: #16a34a;
    }
    * {
    box-sizing: border-box;
    font-family: Arial, sans-serif;
    }
    body {
    margin: 0;
    min-height: 100vh;
    background: linear-gradient(135deg, #eef4ff 0%, #f9fbff 100%);
    color: var(--text);
    padding: 24px;
    }
    .menu-shell {
    max-width: 1100px;
    margin: 0 auto;
    }
    .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 32px;
    }
    .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    }
    .brand img {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    object-fit: cover;
    box-shadow: 0 10px 20px rgba(31, 78, 216, 0.12);
    border: 2px solid var(--line);
    }
    .brand h1 {
    margin: 0;
    font-size: clamp(1.3rem, 2vw, 2rem);
    color: var(--primary);
    }
    .user-panel {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 10px 16px;
    box-shadow: 0 10px 25px rgba(15, 23, 42, 0.05);
    }
    .avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--primary-soft);
    color: var(--primary);
    font-weight: 700;
    }
    .welcome {
    font-size: 0.88rem;
    color: var(--muted);
    }
    .user-name {
    font-weight: 700;
    color: var(--text);
    }
    .logout-btn {
    border: none;
    background: var(--primary);
    color: white;
    border-radius: 10px;
    padding: 10px 16px;
    font-weight: 700;
    cursor: pointer;
    }
    .hero {
    background: linear-gradient(135deg, #1f4ed8, #2563eb);
    border-radius: 24px;
    color: white;
    padding: clamp(24px, 4vw, 42px);
    margin-bottom: 28px;
    box-shadow: 0 18px 40px rgba(31, 78, 216, 0.18);
    text-align: center;
    }
    .hero h2 {
    margin: 0 0 10px;
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    text-align: center;
    }
    .hero p {
    margin: 0 auto;
    max-width: 650px;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
    text-align: center;
    }
    .menu-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    }
    .card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 20px;
    box-shadow: 0 14px 30px rgba(15, 23, 42, 0.08);
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-height: 260px;
    }
    .icon {
    width: 54px;
    height: 54px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    font-size: 1.6rem;
    margin-bottom: 18px;
    background: var(--primary-soft);
    }
    .card h3 {
    margin: 0 0 10px;
    font-size: 1.4rem;
    color: var(--text);
    text-align: center;
    }
    .card p {
    margin: 0 0 18px;
    line-height: 1.6;
    color: var(--muted);
    flex: 1;
    text-align: center;
    }
    .nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 10px;
    background: var(--primary);
    color: white;
    text-decoration: none;
    font-weight: 700;
    padding: 12px 16px;
    transition: background 0.2s ease, transform 0.2s ease;
    }
    .nav-link:hover {
    background: var(--primary-dark);
    transform: translateY(-1px);
    }
    @media (max-width: 900px) {
    .menu-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    }
    @media (max-width: 600px) {
    body {
    padding: 16px;
    }
    .topbar {
    align-items: flex-start;
    }
    .user-panel {
    width: 100%;
    justify-content: space-between;
    }
    .menu-grid {
    grid-template-columns: 1fr;
    }
    .card {
    min-height: auto;
    }
    }
.menu-shell
  header.topbar
    .brand
      img(src='/images/Wallet1-2292428_1920.jpg' alt='Smart Wallet logo')
      h1 Smart Wallet
    .user-panel
      #avatarInitial.avatar U
      div
        .welcome Welcome
        #userName.user-name User
      button#logoutBtn.logout-btn(type='button') Log out
  section.hero
    h2 Choose your workspace
    p
      | Track daily spending, set monthly limits, and view a clear summary of your financial activity.
  main.menu-grid
    article.card
      .icon &#x1F4B8;
      h3 Expenses
      p
        | Record your daily spending, choose a currency, add a category, reason, and date, then save the transaction.
      a.nav-link(href='/expensetracker') Open Expense
    article.card
      .icon &#x1F4CA;
      h3 Budgets
      p
        | Set monthly household and personal limits by category so you can stay in control of your finances.
      a.nav-link(href='/budgets') Open Budgets
    article.card
      .icon &#x1F4C8;
      h3 Summary
      p
        | Review totals, category breakdowns, and monthly trends to understand where your money is going.
      a.nav-link(href='/summary') Open Summary

script.
  (function () {
    const userNameEl = document.getElementById('userName');
    const avatarInitialEl = document.getElementById('avatarInitial');
    const logoutBtn = document.getElementById('logoutBtn');
    const userName = !{JSON.stringify(loggedInUser || 'User')};

    if (userNameEl) {
      userNameEl.textContent = userName;
    }

    if (avatarInitialEl && userName) {
      avatarInitialEl.textContent = userName.charAt(0).toUpperCase();
    }

    if (logoutBtn) {
      logoutBtn.addEventListener('click', async function () {
        try {
          const response = await fetch('/auth/logout', {
            method: 'POST',
            credentials: 'same-origin'
          });

          if (response.redirected) {
            window.location.href = response.url;
            return;
          }
        } catch (error) {
          console.error('Unable to clear session:', error);
        }

        window.location.href = '/auth/Login';
      });
    }
  })();
