doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Monthly Expense Summary
  style.
    * {
    box-sizing: border-box;
    font-family: Arial, sans-serif;
    }
    body {
    margin: 0;
    background: linear-gradient(135deg, #eef4ff 0%, #f9fbff 100%);
    color: #0f172a;
    min-height: 100vh;
    padding: 24px;
    }
    .summary-container {
    max-width: 1100px;
    margin: 0 auto;
    }
    .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
    }
    .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 220px;
    }
    .brand-logo {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    object-fit: cover;
    border: 2px solid #dbeafe;
    box-shadow: 0 8px 18px rgba(31, 78, 216, 0.12);
    }
    .brand-name {
    font-size: clamp(1.1rem, 1.6vw, 1.6rem);
    font-weight: 800;
    color: #1f4ed8;
    margin: 0;
    }
    h1 {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.7rem);
    }
    .month-picker {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    border-radius: 12px;
    padding: 10px 14px;
    box-shadow: 0 10px 25px rgba(15, 23, 42, 0.08);
    }
    .month-picker label {
    font-weight: 700;
    color: #1f4ed8;
    }
    .month-picker input {
    border: 1px solid #dbeafe;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    }
    .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 24px;
    }
    .stat-card {
    background: white;
    border-radius: 16px;
    padding: 20px;
    box-shadow: 0 12px 25px rgba(15, 23, 42, 0.08);
    }
    .stat-label {
    font-size: 0.82rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
    font-weight: 700;
    }
    .stat-value {
    font-size: clamp(1.4rem, 2vw, 2rem);
    font-weight: 800;
    color: #0f172a;
    }
    .content-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 24px;
    }
    .panel {
    background: white;
    border-radius: 16px;
    box-shadow: 0 12px 25px rgba(15, 23, 42, 0.08);
    padding: 20px;
    }
    .panel h3 {
    margin: 0 0 16px;
    font-size: 1.1rem;
    }
    .expense-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    }
    .expense-row {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 0.8fr;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 10px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    align-items: center;
    }
    .expense-row.header {
    background: #eff6ff;
    font-weight: 700;
    color: #1f4ed8;
    }
    .category-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    }
    .category-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 12px;
    border-radius: 10px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    }
    .category-name {
    font-weight: 600;
    }
    .category-amount {
    font-weight: 700;
    color: #1f4ed8;
    }
    @media (max-width: 900px) {
    .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .content-grid {
    grid-template-columns: 1fr;
    }
    }
    @media (max-width: 600px) {
    body {
    padding: 16px;
    }
    .topbar {
    align-items: flex-start;
    }
    .stats-grid {
    grid-template-columns: 1fr;
    }
    .expense-row {
    grid-template-columns: 1fr;
    }
    .expense-row.header {
    display: none;
    }
    }
.summary-container
  .topbar
    .brand
      img.brand-logo(src='/images/Wallet1-2292428_1920.jpg' alt='Smart Wallet Logo')
      p.brand-name Smart Wallet
    .month-picker
      label(for='monthInput') Month
      input#monthInput(type='month')
  h3 Monthly Expense Summary
  .stats-grid
    .stat-card
      .stat-label Total Spent
      #totalSpent.stat-value #{typeof totalSpent !== 'undefined' ? ((transactions && transactions.length ? transactions[0].currency : (lifetimeCurrency || 'UGX')) + ' ' + totalSpent.toFixed(2)) : 'UGX 0.00'}
    .stat-card
      .stat-label Average / Day
      #averageDay.stat-value #{typeof averagePerDay !== 'undefined' ? ((transactions && transactions.length ? transactions[0].currency : (lifetimeCurrency || 'UGX')) + ' ' + averagePerDay.toFixed(2)) : 'UGX 0.00'}
    .stat-card
      .stat-label Highest Category
      #highestCategory.stat-value #{highestCategory || '-'}
    .stat-card
      .stat-label Transactions
      #transactionCount.stat-value #{transactionCount || 0}
  .content-grid
    .panel
      h3 Monthly Expense Details
      #expenseList.expense-list
        .expense-row.header
          span Date
          span Category
          span Reason
          span Amount
        if transactions && transactions.length
          each t in transactions
            .expense-row
              span #{t.date}
              span #{t.category || 'Other'}
              span #{t.reason || 'No reason'}
              span #{(t.currency || (lifetimeCurrency || 'UGX')) + ' ' + (t.amount != null ? Number(t.amount).toFixed(2) : '0.00')}
        else
          .expense-row
            span(colspan='4') No expense data for this month.
    .panel
      h3 Category Summary
      #categoryList.category-list
        if categoryTotals && Object.keys(categoryTotals).length
          - for (const name in categoryTotals)
            .category-item
              span.category-name #{name}
              span.category-amount #{(transactions && transactions.length ? transactions[0].currency : (lifetimeCurrency || 'UGX')) + ' ' + Number(categoryTotals[name] || 0).toFixed(2)}
        else
          .category-item
            span.category-name No data
            span.category-amount #{lifetimeCurrency || 'UGX'} 0.00
script.
  const monthInput = document.getElementById('monthInput');
  if (monthInput) {
    monthInput.value = '!{selectedMonth || new Date().toISOString().slice(0,7)}';
    monthInput.addEventListener('change', function () {
      if (this.value) window.location.href = '/summary?month=' + encodeURIComponent(this.value);
    });
  }
